# Server Environment Variables Template
PORT=8000 # On Render, PORT is assigned dynamically by the platform
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net
CORS_ORIGIN=http://localhost:5173 # In production, set to https://<your-service-name>.onrender.com

# Authentication Secrets
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_here
ACCESS_TOKEN_EXPIRATION=3h
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_here
REFRESH_TOKEN_EXPIRATION=15d

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
