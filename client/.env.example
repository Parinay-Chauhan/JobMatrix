# Client Environment Variables Template
# For local independent dev server (Vite on :5173 talking to Express on :8000)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SOCKET_URL=http://localhost:8000

# For production unified single-origin build on Render:
# Set this in Render Environment Variables or let it fallback automatically:
# VITE_API_BASE_URL=/api/v1
# (VITE_SOCKET_URL automatically falls back to window.location.origin)
